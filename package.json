{
  "name": "@storytw/eslint-config",
  "version": "2.1.0",
  "description": "Storytw shared ESLint config",
  "type": "module",
  "keywords": [
    "eslint-config"
  ],
  "author": "StoryTW",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configs": {
      "types": "./dist/configs/index.d.ts",
      "import": "./dist/configs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run typecheck && tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-x": "5.28.4",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
